{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/deev-ai",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/news",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/news/:path*",
      "destination": "/blog/:path*",
      "permanent": true
    },
    {
      "source": "/:locale(fr|de)/news",
      "destination": "/:locale/blog",
      "permanent": true
    },
    {
      "source": "/:locale(fr|de)/news/:path*",
      "destination": "/:locale/blog/:path*",
      "permanent": true
    }
  ]
}
