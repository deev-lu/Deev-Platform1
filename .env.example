# Supabase – copy this file to .env and fill in your values
# Get these from: https://supabase.com/dashboard → your project → Settings → API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ── Business Hub (/hub) ─────────────────────────────────────
# Its own Supabase project (see HUB.md). The anon key is public by design;
# Row Level Security protects the data. Used by the browser build and by the
# functions in api/hub (which also accept HUB_SUPABASE_URL / HUB_SUPABASE_ANON_KEY).
VITE_HUB_SUPABASE_URL=https://your-hub-project-ref.supabase.co
VITE_HUB_SUPABASE_ANON_KEY=your-hub-anon-public-key-here

# Claude API key for the Hub's AI agents. Server only: set it in Vercel,
# never with a VITE_ prefix (that would ship it to every browser).
ANTHROPIC_API_KEY=
# Optional: the model every Hub agent uses (default claude-opus-5-5).
# HUB_MODEL=claude-opus-5-5
